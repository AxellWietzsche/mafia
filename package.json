{
  "name": "mafia",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter ./mafia-backend dev\" \"pnpm --filter ./mafia-frontend dev --host\"",
    "dev:backend": "pnpm --filter ./mafia-backend dev",
    "dev:frontend": "pnpm --filter ./mafia-frontend dev",
    "build": "pnpm --filter ./mafia-backend build && pnpm --filter ./mafia-frontend build",
    "build:backend": "pnpm --filter ./mafia-backend build",
    "build:frontend": "pnpm --filter ./mafia-frontend build",
    "start": "pnpm --filter ./mafia-backend start",
    "install:all": "pnpm install",
    "lint": "pnpm --filter ./mafia-backend lint && pnpm --filter ./mafia-frontend lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
